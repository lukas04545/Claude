<?xml version="1.0" encoding="utf-8"?>
<!--
  Floating overlay panel shown on top of Clash Royale.
  Semi-transparent dark card with:
   - Header: "Enemy Elixir" label + double/triple indicator
   - Elixir bar (coloured fill 0-10)
   - Numeric value + advantage text
   - Scrollable list of last 4 played cards
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/overlay_background"
    android:padding="10dp"
    android:elevation="10dp">

    <!-- Header row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/elixir_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Enemy Elixir"
            android:textColor="#E0E0E0"
            android:textSize="11sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/elixir_advantage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="≈ even"
            android:textColor="#FFFFFF"
            android:textSize="10sp"/>
    </LinearLayout>

    <!-- Elixir bar container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:background="#33FFFFFF"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <!-- Filled portion — weight is updated programmatically -->
        <View
            android:id="@+id/elixir_fill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.5"
            android:background="#4CAF50"/>

        <!-- Unfilled remainder -->
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.5"
            android:background="@android:color/transparent"/>
    </LinearLayout>

    <!-- Numeric value -->
    <TextView
        android:id="@+id/elixir_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="5.0"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="10dp"/>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#44FFFFFF"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Last cards played"
        android:textColor="#90A4AE"
        android:textSize="10sp"
        android:layout_marginBottom="6dp"/>

    <!-- Card list — populated dynamically -->
    <LinearLayout
        android:id="@+id/card_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"/>

</LinearLayout>
